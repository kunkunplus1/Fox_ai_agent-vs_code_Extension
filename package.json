    "submenus": [
      {
        "id": "foxAi.editorSubmenu",
        "label": "🦊 狐狸 AI"
      },
      {
        "id": "foxAi.storageSubmenu",
        "label": "存储"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "foxAi.fixDiagnostic",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "foxAi.openChat",
          "when": "view == foxAi.sessions",
          "group": "navigation@0"
        },
        {
          "command": "foxAi.stop",
          "when": "view == foxAi.sessions && foxAi.running",
          "group": "navigation@1"
        },
        {
          "command": "foxAi.newChat",
          "when": "view == foxAi.sessions",
          "group": "navigation@2"
        },
        {
          "command": "foxAi.openEnvManager",
          "when": "view == foxAi.sessions",
          "group": "navigation@3"
        },
        {
          "command": "foxAi.setSessionStorage",
          "when": "view == foxAi.sessions",
          "group": "navigation@4"
        },
        {
          "submenu": "foxAi.storageSubmenu",
          "when": "view == foxAi.sessions",
          "group": "navigation@5"
        },
        {
          "command": "foxAi.openAnyFile",
          "when": "view == foxAi.files",
          "group": "navigation@0"
        },
        {
          "command": "foxAi.projectOutline",
          "when": "view == foxAi.files",
          "group": "navigation@1"
        }
      ],
      "foxAi.storageSubmenu": [
        {
          "command": "foxAi.openSessionStorage",
          "group": "open@1"
        },
        {
          "command": "foxAi.openMemoryStorage",
          "group": "open@2"
        },
        {
          "command": "foxAi.openUserSkillStorage",
          "group": "open@3"
        },
        {
          "command": "foxAi.openPlanTaskStorage",
          "group": "open@4"
        },
        {
          "command": "foxAi.setSessionStorage",
          "group": "change@1"
        },
        {
          "command": "foxAi.setMemoryStorage",
          "group": "change@2"
        },
        {
          "command": "foxAi.setUserSkillStorage",
          "group": "change@3"
        },
        {
          "command": "foxAi.setPlanTaskStorage",
          "group": "change@4"
        }
      ],
      "view/item/context": [
        {
          "command": "foxAi.renameSession",
          "when": "view == foxAi.sessions && viewItem == foxAi.session",
          "group": "inline@0"
        },
        {
          "command": "foxAi.deleteSession",
          "when": "view == foxAi.sessions && viewItem == foxAi.session",
          "group": "inline@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "foxAi.editorSubmenu",
          "group": "0_foxai",
          "when": "editorTextFocus"
        }
      ],
      "foxAi.editorSubmenu": [
        {
          "command": "foxAi.explainCode",
          "group": "1_ask@1"
        },
        {
          "command": "foxAi.refactorCode",
          "group": "1_ask@2"
        },
        {
          "command": "foxAi.addComments",
          "group": "1_ask@3"
        },
        {
          "command": "foxAi.generateTests",
          "group": "1_ask@4"
        },
        {
          "command": "foxAi.fixCode",
          "group": "1_ask@5"
        },
        {
          "command": "foxAi.askAboutSelection",
          "group": "2_free@1"
        }
      ],
      "terminal/context": [
        {
          "command": "foxAi.explainTerminalError",
          "group": "0_foxai"
        }
      ]
    },
    "keybindings": [
      {
        "command": "foxAi.askAboutSelection",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      },
      {
        "command": "foxAi.openChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "foxAi.stop",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q"
      }
    ],
    "configuration": [
      {
        "title": "%foxai.n116%",
        "properties": {
          "foxAi.provider": {
            "type": "string",
            "default": "llamacpp",
            "order": 1,
            "enum": [
              "llamacpp",
              "ollama",
              "lmstudio",
              "deepseek",
              "zhipu",
              "dashscope",
              "moonshot",
              "siliconflow",
              "openrouter",
              "custom"
            ],
            "enumDescriptions": [
              "本地 llama.cpp server（默认 http://127.0.0.1:8080/v1）",
              "本地 Ollama（默认 http://127.0.0.1:11434/v1）",
              "本地 LM Studio（默认 http://127.0.0.1:1234/v1）",
              "DeepSeek 深度求索",
              "智谱 GLM（BigModel 开放平台）",
              "阿里云百炼 / 通义千问（兼容模式）",
              "月之暗面 Kimi",
              "硅基流动 SiliconFlow",
              "OpenRouter",
              "自定义 OpenAI 兼容服务"
            ],
            "description": "%foxai.n117%"
          },
          "foxAi.baseUrl": {
            "type": "string",
            "default": "",
            "order": 2,
            "description": "%foxai.n118%"
          },
          "foxAi.model": {
            "type": "string",
            "default": "",
            "order": 3,
            "description": "%foxai.n119%"
          },
          "foxAi.apiKey": {
            "type": "string",
            "default": "",
            "order": 4,
            "markdownDescription": "%foxai.n120%"
          },
          "foxAi.systemPrompt": {
            "type": "string",
            "default": "你是一位资深工程师，回答简洁准确，默认使用中文。",
            "editPresentation": "multilineText",
            "order": 5,
            "description": "%foxai.n121%"
          },
          "foxAi.temperature": {
            "type": "number",
            "default": 0.3,
            "minimum": 0,
            "maximum": 2,
            "description": "%foxai.n122%"
          },
          "foxAi.maxTokens": {
            "type": "number",
            "default": 4096,
            "description": "%foxai.n123%"
          },
          "foxAi.timeout": {
            "type": "number",
            "default": 60000,
            "markdownDescription": "%foxai.n124%"
          },
          "foxAi.maxHistory": {
            "type": "number",
            "default": 20,
            "description": "%foxai.n125%"
          },
          "foxAi.includeFileContext": {
            "type": "boolean",
            "default": true,
            "description": "%foxai.n126%"
          },
          "foxAi.forceNonStream": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%foxai.n127%",
            "order": 9
          },
          "foxAi.streamFormat": {
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "sse",
              "jsonl"
            ],
            "enumDescriptions": [
              "根据响应 Content-Type 自动识别（SSE / JSON Lines / 普通 JSON）",
              "强制按 SSE（text/event-stream）解析",
              "强制按 JSON Lines（application/x-ndjson 或 application/json 逐行）解析，兼容 MCP Streamable HTTP"
            ],
            "markdownDescription": "%foxai.n128%",
            "order": 10
          },
          "foxAi.insecureHttpParser": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%foxai.n129%",
            "order": 10
          },
          "foxAi.visionMode": {
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "on",
              "off"
            ],
            "enumDescriptions": [
              "自动按模型名判断是否支持读图",
              "强制把图片发给模型（模型不支持会报 400）",
              "从不发送图片，只发文件名"
            ],
            "markdownDescription": "%foxai.n130%",
            "order": 11
          },
          "foxAi.visionModels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%foxai.n131%",
            "order": 12
          },
          "foxAi.textOnlyModels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%foxai.n132%",
            "order": 13
          },
          "foxAi.keepImageTurns": {
            "type": "number",
            "default": 1,
            "description": "%foxai.n133%",
            "order": 12
          },
          "foxAi.attachment.maxSizeMB": {
            "type": "number",
            "default": 6,
            "description": "%foxai.n134%",
            "order": 13
          },
          "foxAi.webSearch.enabled": {
            "type": "boolean",
            "default": false,
            "description": "%foxai.n135%"
          },
          "foxAi.webSearch.provider": {
            "type": "string",
            "default": "builtin",
            "enum": [
              "builtin",
              "duckduckgo",
              "tavily",
              "serper"
            ],
            "enumDescriptions": [
              "自动选择可用搜索源（默认 DuckDuckGo，无需 Key）",
              "DuckDuckGo HTML（无需 Key，稳定性一般）",
              "Tavily API（需 Key，更稳定）",
              "Serper/Google API（需 Key）"
            ]
          },
          "foxAi.webSearch.apiKey": {
            "type": "string",
            "default": "",
            "description": "%foxai.n136%"
          },
          "foxAi.apiMode": {
            "type": "string",
            "enum": [
              "chat",
              "responses"
            ],
            "default": "chat",
            "markdownDescription": "API protocol. chat = OpenAI-compatible /chat/completions (default, works with all providers). responses = OpenAI Responses API (/v1/responses, native function calling and reasoning deltas), supported by OpenAI official and DeepSeek (deepseek-v4-flash; see api-docs.deepseek.com). Selecting the openai provider defaults to responses. Other third-party services (Zhipu, Ollama, LM Studio, etc.) may not implement /responses; forcing it on an unsupported endpoint will error."
          }
        }
      },
